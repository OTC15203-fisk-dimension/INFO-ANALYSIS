rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /audit/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /agentMessages/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.env in ['dev', 'sandbox'];
    }
  }
}
